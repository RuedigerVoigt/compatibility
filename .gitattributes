# Store all text files with LF line endings, whatever the contributor's
# core.autocrlf setting or editor.
* text=auto eol=lf

# Show the enclosing function in `git diff` hunk headers.
*.py diff=python

# Generated by `python compile_translations.py --extract`: collapsed in
# GitHub diffs and left out of the language statistics.
compatibility/locales/compatibility.pot linguist-generated=true
